# How it was verified: built the image and ran the staging stack locally (docker-compose.staging.yml).
# Reviewed by: Viktoriia Baran

FROM node:26-slim AS build
WORKDIR /app
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
# No install scripts, except the one that downloads the engine `prisma migrate deploy` runs.
RUN npm ci --ignore-scripts && npm rebuild @prisma/engines && node_modules/.bin/prisma generate
COPY tsconfig.json nest-cli.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:26-slim
# Links the GHCR package to the repository, so it gets the repository's access permissions; it stays
# private, and the server logs in on every deploy.
LABEL org.opencontainers.image.source=https://github.com/ukma-fin-ssdm-2026/pun-intended-team
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/package.json /app/prisma.config.ts ./
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4100
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch(`http://localhost:${process.env.PORT ?? 4100}/health`).then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/api/main.js"]
