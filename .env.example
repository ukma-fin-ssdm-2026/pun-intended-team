PORT=4100
NODE_ENV=development
SWAGGER_UI=false
CORS_ORIGINS=http://localhost:8081
# Key files, created by npm run keys:generate
CODE_HMAC_KEY_FILE=keys/code-hmac.key
JWT_KEYS_FILE=keys/jwt-keys.json

# Local database for `docker compose up -d` (docker-compose.yml).
POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby_dev_password
POSTGRES_DB=nearby
POSTGRES_PORT=5432
# keep them in sync with above
# Migrations and `npm run db:set-passwords` connect as the owner (the user above).
DATABASE_URL=postgresql://nearby:nearby_dev_password@localhost:5432/nearby?schema=public
# The API connects as nearby_main, the import service as nearby_import (docs/architecture/mechanisms/database-access.md).
# The roles come from a migration; `npm run db:set-passwords` sets these passwords.
MAIN_DATABASE_URL=postgresql://nearby_main:nearby_main_dev_password@localhost:5432/nearby?schema=public
IMPORT_DATABASE_URL=postgresql://nearby_import:nearby_import_dev_password@localhost:5432/nearby?schema=public
