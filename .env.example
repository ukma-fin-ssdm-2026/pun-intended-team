PORT=4100
NODE_ENV=development
SWAGGER_UI=false
CORS_ORIGINS=http://localhost:8081
# Requests per minute per IP to each public sign-in and code endpoint.
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY=

CODE_HMAC_KEY_FILE=keys/code-hmac.key
JWT_KEYS_FILE=keys/jwt-keys.json
CONTACT_HMAC_KEY_FILE=keys/contact-hmac.key
DATA_ENCRYPTION_KEY_FILE=keys/data-encryption.key

MESSAGING_PROVIDER=
TELEGRAM_GATEWAY_TOKEN=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# Comma-separated client ids of every Google OAuth client the app signs in with (web, iOS, Android).
GOOGLE_CLIENT_IDS=

ALLOW_TEST_ADAPTERS=false

POSTGRES_USER=nearby
POSTGRES_PASSWORD=nearby_dev_password
POSTGRES_DB=nearby
POSTGRES_PORT=5432

# Built from the four values above; keep them in sync. Prisma reads it.
# Migrations and `npm run db:set-passwords` connect as the owner (the user above).
DATABASE_URL=postgresql://nearby:nearby_dev_password@localhost:5432/nearby?schema=public

# The API connects as nearby_main, the import service as nearby_import (docs/architecture/mechanisms/database-access.md).
# The roles come from a migration; `npm run db:set-passwords` sets these passwords.
MAIN_DATABASE_URL=postgresql://nearby_main:nearby_main_dev_password@localhost:5432/nearby?schema=public
# Import service only: `npm run import:events` reads this variable and the event import settings below.
IMPORT_DATABASE_URL=postgresql://nearby_import:nearby_import_dev_password@localhost:5432/nearby?schema=public
# Backup service only (staging): the read-only role nearby_backup. Only `npm run db:set-passwords` reads it.
BACKUP_DATABASE_URL=postgresql://nearby_backup:nearby_backup_dev_password@localhost:5432/nearby?schema=public

# Time limits of the API's database calls in milliseconds (REL-01); a call that runs out of time answers 503.
# Wait for a free pool connection or a new connection.
DATABASE_CONNECT_TIMEOUT_MS=5000
# Postgres cancels a statement after this; the client gives up 1 s later if the server does not answer at all.
DATABASE_STATEMENT_TIMEOUT_MS=10000
# Wait for a row or table lock; must not exceed the statement timeout.
DATABASE_LOCK_TIMEOUT_MS=3000
# Postgres ends a session that stays idle inside an open transaction.
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Event import (npm run import:events). Requests name the service; Nominatim's usage policy asks for this.
IMPORT_USER_AGENT=NearbyImport/1.0 (+https://github.com/ukma-fin-ssdm-2026/pun-intended-team)
# The key ArtWizard gave the team for its events API (ADR-006). Secret; ask the team. Unset, the ArtWizard run fails
# and the other providers still run.
ARTWIZARD_API_KEY=
# Test only, unset everywhere else: the e2e tests point the import at a local server with saved pages, with no
# wait between requests (otherwise 1000 ms, the sites' Crawl-delay) and a fixed "now" for the catalog window.
# ARTWIZARD_API_URL=
# KARABAS_BASE_URL=
# NOMINATIM_BASE_URL=
# IMPORT_REQUEST_INTERVAL_MS=
# IMPORT_NOW=
