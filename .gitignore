# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# Lock files are intentionally NOT ignored — commit package-lock.json
# (or yarn.lock / pnpm-lock.yaml) so everyone builds the same tree.

# ---- Build output ----
dist/
build/
.vite/

# ---- Environment / secrets ----
# Never commit real credentials. Commit a .env.example with dummy values instead.
.env
.env.local
.env.*.local

# Local key files (npm run keys:generate)
keys/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Testing ----
/coverage/

# ---- Editors ----
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Claude Code ----
.claude

# ---- Prisma ----
# Client generated by `prisma generate` (see prisma/schema.prisma).
generated/
