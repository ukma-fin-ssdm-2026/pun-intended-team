generator client {
  provider = "prisma-client"
  output   = "../src/infra/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  user
  admin

  @@map("account_role")
}

enum AccountStatus {
  pending
  active
  banned

  @@map("account_status")
}

enum AuthMethodType {
  password
  google

  @@map("auth_method_type")
}

enum VerificationChannel {
  telegram
  sms

  @@map("verification_channel")
}

enum VerificationPurpose {
  registration
  reset

  @@map("verification_purpose")
}

enum DesiredCompany {
  friends
  casual
  dating

  @@map("desired_company")
}

enum VerificationStatus {
  pending
  verified
  rejected
  revoked

  @@map("verification_status")
}

enum ContentSource {
  organization
  import

  @@map("content_source")
}

enum EventStatus {
  published
  cancelled

  @@map("event_status")
}

enum SessionStatus {
  scheduled
  cancelled

  @@map("session_status")
}

enum ApplicationStatus {
  in_pool
  paired
  paused
  removed
  withdrawn
  no_match
  cancelled

  @@map("application_status")
}

enum MatchSource {
  instant
  round
  open

  @@map("match_source")
}

enum MatchStatus {
  proposed
  accepted_a
  accepted_b
  mutual
  declined
  expired
  cancelled

  @@map("match_status")
}

enum MatchCancelReason {
  event_cancelled
  participant_banned
  participant_withdrew

  @@map("match_cancel_reason")
}

enum ExclusionReason {
  declined
  expired

  @@map("exclusion_reason")
}

enum ListingStatus {
  active
  removed

  @@map("listing_status")
}

enum ReportTargetType {
  account
  listing

  @@map("report_target_type")
}

enum ReportCaseStatus {
  open
  resolved

  @@map("report_case_status")
}

enum ReportResolution {
  banned
  removed
  dismissed

  @@map("report_resolution")
}

enum NotificationType {
  match_proposed
  match_mutual
  respond_soon
  not_a_match
  continue_matching
  removed_from_matching
  no_match_found
  event_reminder
  event_changed
  report_received

  @@map("notification_type")
}

enum PushStatus {
  pending
  sent
  failed
  skipped

  @@map("push_status")
}

enum DevicePlatform {
  ios
  android

  @@map("device_platform")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events   Event[]
  listings Listing[]

  @@map("categories")
}

model Account {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               AccountRole   @default(user)
  contactIdentifier  Bytes         @map("contact_identifier")
  contactHash        Bytes         @unique @map("contact_hash")
  dateOfBirth        Bytes?        @map("date_of_birth")
  status             AccountStatus @default(pending)
  failedSignins      Int           @default(0) @map("failed_signins")
  failedSigninsSince DateTime?     @map("failed_signins_since") @db.Timestamptz(3)
  lockedUntil        DateTime?     @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  authMethods           AuthMethod[]
  refreshTokens         RefreshToken[]
  profile               Profile?
  organization          Organization?  @relation("OrganizationAccount")
  verifiedOrganizations Organization[] @relation("OrganizationVerifier")
  applications          Application[]
  exclusions            Exclusion[]    @relation("ExclusionUser")
  excludedIn            Exclusion[]    @relation("ExclusionExcludedUser")
  listings              Listing[]
  reportCasesAsTarget   ReportCase[]   @relation("ReportCaseTargetAccount")
  reportCasesResolved   ReportCase[]   @relation("ReportCaseResolver")
  reports               Report[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]

  @@map("accounts")
}

model AuthMethod {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String         @map("account_id") @db.Uuid
  type      AuthMethodType
  secret    String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([accountId, type])
  @@unique([type, secret])
  @@map("auth_methods")
}

model VerificationCode {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact           Bytes
  contactHash       Bytes                @map("contact_hash")
  channel           VerificationChannel?
  providerRequestId String?              @map("provider_request_id")
  codeHash          String               @map("code_hash")
  purpose           VerificationPurpose
  sentAt            DateTime             @default(now()) @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(3)
  attempts          Int                  @default(0)
  usedAt            DateTime?            @map("used_at") @db.Timestamptz(3)
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([contactHash, sentAt])
  @@map("verification_codes")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deviceToken DeviceToken?

  @@index([accountId])
  @@map("refresh_tokens")
}

model Profile {
  accountId           String         @id @map("account_id") @db.Uuid
  username            String
  displayName         String         @map("display_name")
  description         String?
  communicationFormat DesiredCompany @map("communication_format")
  sharePhone          Boolean        @default(true) @map("share_phone")
  safetyNoticeAckAt   DateTime?      @map("safety_notice_ack_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  photo            ProfilePhoto?
  linkedAccounts   LinkedAccount[]
  profileInterests ProfileInterest[]

  @@map("profiles")
}

model ProfilePhoto {
  profileId   String   @id @map("profile_id") @db.Uuid
  content     Bytes
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [accountId], onDelete: Cascade, onUpdate: Cascade)

  @@map("profile_photos")
}

model LinkedAccount {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  app       String
  username  Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [accountId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([profileId, app])
  @@map("linked_accounts")
}

model Interest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profileInterests ProfileInterest[]

  @@map("interests")
}

model ProfileInterest {
  profileId  String   @map("profile_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile  Profile  @relation(fields: [profileId], references: [accountId], onDelete: Cascade, onUpdate: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([profileId, interestId])
  @@map("profile_interests")
}

model Organization {
  accountId          String             @id @map("account_id") @db.Uuid
  name               String
  description        String?
  officialLink       String?            @map("official_link")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verifiedById       String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account    Account  @relation("OrganizationAccount", fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verifiedBy Account? @relation("OrganizationVerifier", fields: [verifiedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events     Event[]
  venues     Venue[]

  @@map("organizations")
}

model Venue {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  address        String
  latitude       Decimal       @db.Decimal(9, 6)
  longitude      Decimal       @db.Decimal(9, 6)
  source         ContentSource
  organizationId String?       @map("organization_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [accountId], onDelete: Restrict, onUpdate: Cascade)
  events       Event[]

  @@map("venues")
}

model Event {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  venueId        String        @map("venue_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  source         ContentSource
  provider       String?
  externalId     String?       @map("external_id")
  title          String
  description    String
  startsAt       DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime      @map("ends_at") @db.Timestamptz(3)
  status         EventStatus   @default(published)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [accountId], onDelete: Restrict, onUpdate: Cascade)
  sessions     EventSession[]
  exclusions   Exclusion[]
  listings     Listing[]

  @@unique([provider, externalId])
  @@map("events")
}

model EventSession {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String        @map("event_id") @db.Uuid
  startsAt  DateTime      @map("starts_at") @db.Timestamptz(3)
  status    SessionStatus @default(scheduled)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applications Application[]

  @@unique([eventId, startsAt])
  @@map("event_sessions")
}

model ImportRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider   String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  status     String
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  skippedRecords SkippedRecord[]

  @@map("import_runs")
}

model SkippedRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importRunId String   @map("import_run_id") @db.Uuid
  raw         Json
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("skipped_records")
}

model Application {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  sessionId       String            @map("session_id") @db.Uuid
  desiredCompany  DesiredCompany    @map("desired_company")
  openToExtend    Boolean           @map("open_to_extend")
  status          ApplicationStatus @default(in_pool)
  noResponseCount Int               @default(0) @map("no_response_count")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       Account      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  session    EventSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  matchesAsA Match[]      @relation("MatchApplicationA")
  matchesAsB Match[]      @relation("MatchApplicationB")

  @@map("applications")
}

model Match {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationAId String             @map("application_a_id") @db.Uuid
  applicationBId String             @map("application_b_id") @db.Uuid
  source         MatchSource
  score          Decimal            @db.Decimal(4, 3)
  seed           BigInt
  status         MatchStatus        @default(proposed)
  cancelReason   MatchCancelReason? @map("cancel_reason")
  validUntil     DateTime           @map("valid_until") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  applicationA Application @relation("MatchApplicationA", fields: [applicationAId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  applicationB Application @relation("MatchApplicationB", fields: [applicationBId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  exclusion    Exclusion?

  @@map("matches")
}

model Exclusion {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  excludedUserId String          @map("excluded_user_id") @db.Uuid
  eventId        String          @map("event_id") @db.Uuid
  matchId        String          @unique @map("match_id") @db.Uuid
  reason         ExclusionReason
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user         Account @relation("ExclusionUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  excludedUser Account @relation("ExclusionExcludedUser", fields: [excludedUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event        Event   @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("exclusions")
}

model Listing {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  eventId     String?       @map("event_id") @db.Uuid
  title       String
  description String
  date        DateTime      @db.Date
  status      ListingStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      Account      @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportCases ReportCase[]

  @@map("listings")
}

model ReportCase {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType      ReportTargetType  @map("target_type")
  targetAccountId String?           @map("target_account_id") @db.Uuid
  targetListingId String?           @map("target_listing_id") @db.Uuid
  status          ReportCaseStatus  @default(open)
  resolution      ReportResolution?
  resolvedById    String?           @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  targetAccount Account? @relation("ReportCaseTargetAccount", fields: [targetAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targetListing Listing? @relation(fields: [targetListingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedBy    Account? @relation("ReportCaseResolver", fields: [resolvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reports       Report[]

  @@map("report_cases")
}

model Report {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String   @map("case_id") @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reason     String
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  case     ReportCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reporter Account    @relation(fields: [reporterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("reports")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  result     String
  ipAddress  String?  @map("ip_address") @db.Inet

  @@map("audit_logs")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String           @map("account_id") @db.Uuid
  type       NotificationType
  payload    Json
  dedupeKey  String           @unique @map("dedupe_key")
  pushStatus PushStatus       @default(pending) @map("push_status")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("notifications")
}

model DeviceToken {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String         @map("account_id") @db.Uuid
  refreshTokenId String         @unique @map("refresh_token_id") @db.Uuid
  pushToken      String         @unique @map("push_token")
  platform       DevicePlatform
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  refreshToken RefreshToken @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("device_tokens")
}
