{
  "name": "nearby-api-mcp",
  "version": "1.1.0",
  "description": "MCP Server generated from OpenAPI spec for nearby-api-mcp",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && shx chmod 755 build/index.js",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "shx": "0.3.4",
    "typescript": "^6.0.3"
  }
}
