@startuml sequence-diagram-auth
/'
  AI Usage Note
  Drafted with Claude from the code and authentication.md.
'/
title Nearby — Sequence Diagram: Registration, Sign-in and Sessions

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Client\n(app, Swagger UI)" as APP
box "api" #F5F5F5
  participant "AuthController\n+ AuthGuard\n+ per-IP limit" as API
end box
box "core: identity" #EEF4FB
  participant "AuthService" as SVC
  participant "SessionsService" as SES
end box
box "infra (behind core interfaces)" #F3F8EE
  database "VerificationCodes\nRepository" as CODES
  database "Accounts\nRepository" as ACC
  database "Sessions\nRepository\n(refresh_tokens)" as SESS
  participant "CodeHasher (HMAC)\nPasswordHasher (argon2id)" as HASH
  participant "AccessTokens (jose, HS256)\nGoogleIdTokens (jose, RS256)" as TOK
  participant "MessagingProvider\n(via core notifications)" as MSG
end box

== Register: request a code (no route while sign-in is Google-only, ADR-004) ==

APP -> API : POST /auth/register {phone}
API -> SVC : register(phone)
SVC -> SVC : random 6-digit code
SVC -> HASH : HMAC(phone:code)
SVC -> CODES : createWithinLimit(hash, expires in 10 min)\n— one step, codes of any purpose
opt none in the last minute and fewer than 5 in 24 hours
  SVC -> MSG : sendCode(phone, code)
  note right of MSG : Telegram Gateway, SMS (TurboSMS) if Telegram\nrefuses or does not answer; console in development
  SVC -> CODES : saveDelivery(channel, provider request id)\n— or delete if no channel took it
end
API --> APP : 202 — same answer for a registered phone and within the minute

== Verify the code (no route while sign-in is Google-only, ADR-004) ==

APP -> API : POST /auth/verify {phone, code}
API -> SVC : verify(…)
SVC -> CODES : findLatest(phone, registration)
alt no code, expired or used
  SVC --> APP : 422 INVALID_CODE
end
SVC -> CODES : addAttempt — counted before the check
alt more than 3 attempts, or HMAC does not match
  SVC --> APP : 422 INVALID_CODE
end
SVC -> CODES : markUsed — false if another request used it first
SVC -> ACC : findByPhone(phone)
alt an active or banned account
  SVC --> APP : 409 CONFLICT
end
SVC -> ACC : create(pending account) — or reuse the pending one
SVC -> TOK : issue(registrant caller, 900 s)
API --> APP : 200 registration token {accessToken, expiresIn: 900}

== Register with Google ==

APP -> API : POST /auth/google/register {idToken}
API -> SVC : registerWithGoogle(idToken)
SVC -> TOK : verify Google ID token — Google's keys, our client ids
alt invalid token
  SVC --> APP : 422 INVALID_GOOGLE_TOKEN
end
SVC -> ACC : findByGoogleSubject(sub)
alt an active or banned account
  SVC --> APP : 409 GOOGLE_ACCOUNT_TAKEN
end
SVC -> ACC : createWithGoogle(sub) — or reuse the pending one;\nno phone number
SVC -> TOK : issue(registrant caller, 900 s)
API --> APP : 200 registration token {accessToken, expiresIn: 900}

== Finish registration: the age check ==

APP -> API : POST /auth/complete-registration {dateOfBirth}\n— registration token
API -> SVC : completeRegistration(accountId, dateOfBirth)
SVC -> ACC : findById(accountId)
alt removed
  SVC --> APP : 404 NOT_FOUND
else no longer pending
  SVC --> APP : 409 CONFLICT
else under 18 by the Kyiv date
  SVC -> ACC : delete — the person can start again
  SVC --> APP : 422 UNDERAGE
end
SVC -> ACC : activate(accountId, dateOfBirth)
SVC -> SES : start(accountId, role)
SES -> SESS : create(accountId, SHA-256(random secret), expires in 30 days)
SES -> TOK : issue(account caller with sid = session id, 3600 s)
API --> APP : 200 {accessToken, expiresIn: 3600,\nrefreshToken: <session id>.<secret>}

== Sign in with a password (no route while sign-in is Google-only, ADR-004) ==

APP -> API : POST /auth/sign-in {phone, password}
API -> SVC : signIn(phone, password)
SVC -> ACC : findPasswordCredential(phone)
SVC -> HASH : verify(hash, password)\n— a stand-in hash for an unknown phone
alt unknown phone or not active
  SVC --> APP : 401 INVALID_CREDENTIALS
end
SVC -> ACC : updateLockout — one step on the stored state:\nlocked stays locked, a failure counts\n(the 5th in 15 min locks for 15 min), a success clears
alt locked or wrong password
  SVC --> APP : 401 INVALID_CREDENTIALS — the same answer every time
end
SVC -> SES : start(accountId, role) — as in Finish registration
API --> APP : 200 {accessToken, expiresIn: 3600, refreshToken}

== Sign in with Google ==

APP -> API : POST /auth/google {idToken}
API -> SVC : signInWithGoogle(idToken)
SVC -> TOK : verify Google ID token — Google's keys, our client ids
SVC -> ACC : findByGoogleSubject(sub)
alt invalid token, not registered or not active
  SVC --> APP : 401 INVALID_CREDENTIALS
end
SVC -> SES : start(accountId, role)
API --> APP : 200 {accessToken, expiresIn: 3600, refreshToken}

== Forgot the password (no route while sign-in is Google-only, ADR-004) ==

APP -> API : POST /auth/password-reset {phone}
API -> SVC : requestPasswordReset(phone)
SVC -> ACC : findByPhone(phone)
opt an active account
  SVC ->> MSG : reset code, sent in the background as in Register
end
API --> APP : 202 — the same answer for any phone
APP -> API : POST /auth/password-reset/confirm {phone, code, password}
API -> SVC : resetPassword(…)
SVC -> CODES : check the latest reset code, as in Verify
SVC -> ACC : setPasswordHash, updateLockout(no failures)
SVC -> SES : endAll(accountId) — whoever knew the old password is signed out
SES -> SESS : revokeAll
SVC -> SES : start(accountId, role)
API --> APP : 200 {accessToken, expiresIn: 3600, refreshToken}

== Renew the access token ==

APP -> API : POST /auth/refresh {refreshToken}
API -> SES : refresh(refreshToken)
SES -> SESS : findById(session id)
alt unknown, revoked or expired
  SES --> APP : 401 INVALID_REFRESH_TOKEN
else wrong secret (already replaced: stolen or replayed), or account not active
  SES -> SESS : revoke — the session ends for every holder
  SES --> APP : 401 INVALID_REFRESH_TOKEN
end
SES -> SESS : rotate — new secret and 30 days, only if the hash is still the old one\n(a concurrent refresh that lost ends the session too)
SES -> TOK : issue(account caller, 3600 s)
API --> APP : 200 {accessToken, expiresIn: 3600, refreshToken} — keep the new one

== Sign out ==

APP -> API : POST /auth/sign-out — access token
API -> SES : end(sid)
SES -> SESS : revoke
API --> APP : 204

== Any protected request ==

APP -> API : GET /api/v1/… — Authorization: Bearer <token>
API -> SVC : authenticate(token)
SVC -> TOK : verify(token)
TOK -> TOK : key by kid; HS256 only; signature;\niss, aud, typ at+jwt; not expired;\nclaims parsed into a Caller
opt an account's token
  SVC -> SES : isActive(sid, accountId)
  SES -> SESS : findById(sid) — not revoked, not expired, same account
end
alt any check fails, or the session ended
  API --> APP : 401 UNAUTHENTICATED
else registration token anywhere but complete-registration
  API --> APP : 401 UNAUTHENTICATED
else guest on a user endpoint
  API --> APP : 401 UNAUTHENTICATED
else user on an admin endpoint
  API --> APP : 404 NOT_FOUND
end
API -> API : handler runs with the Caller

note over APP, MSG
  Errors: AuthService throws a DomainError with a code; ApiExceptionFilter (api) turns it into the status shown.
  Token: header {alg HS256, kid, typ at+jwt}; claims sub, role (guest, registrant, user, admin), sid (accounts only), iss/aud nearby-api, iat, exp.
  Limits: Google register, Google sign-in and refresh allow 20 requests a minute per IP each (429 RATE_LIMITED).
  Sessions: a password change or reset ends the other sessions (endAll), once the phone flow returns.
  Storage: phone numbers and dates of birth are encrypted (AES-256-GCM), phones looked up by HMAC (contact_hash) inside the repositories.
  Planned, not shown: audit records (SEC-004).
end note
@enduml
