@startuml code-structure
/'
  AI Usage Note
  Drafted with Claude from the code in src/.
'/
title Nearby — Code Structure (src/): modules

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
hide circle

package "api (HTTP), started by src/api/main.ts" as API {
  class "common (AuthGuard)" as A_COMMON
  class "identity" as A_ID
  class "profiles" as A_PR
  class "catalog" as A_CA
  class "listings" as A_LI
  class "images" as A_IMG
  class "matching" as A_MA
  class "moderation" as A_MO
  class "admin" as A_AD
  class "system" as A_SY
}

package "core (business logic)" as CORE {
  class "admin" as C_AD
  class "moderation" as C_MO
  class "matching" as C_MA
  class "listings" as C_LI
  class "profiles" as C_PR
  class "catalog" as C_CA
  class "identity" as C_ID
  class "notifications" as C_NO
  class "images" as C_IMG
  class "system" as C_SY
  class "import" as C_IM
  class "jobs (port only)" as C_JO
  class "common (TransactionRunner)" as C_COMMON
}

package "infra (data access and external services)" as INFRA {
  class "prisma: every repository,\nTransactionRunner, DatabaseProbe" as I_PRISMA
  class "auth" as I_AUTH
  class "messaging" as I_MSG
  class "jobs" as I_JOBS
  class "providers" as I_PROV
  class "geocoding" as I_GEO
  class "images (sharp)" as I_IMG
  class "stubs (unit test only)" as I_STUBS
  note as BINDINGS
    **InfraModule** (API process): prisma (nearby_main),
    auth, messaging, jobs, images
    **ImportInfraModule** (import process): prisma
    (nearby_import), providers, geocoding, and jobs
    with withJobQueue()
  end note
}

package "import process (CMP-03), src/import/" as PROC {
  class "ImportAppModule\nonce(), worker()" as IMPORT_APP
}

' api modules call their core module
A_COMMON --> C_ID
A_ID --> C_ID
A_PR --> C_PR
A_CA --> C_CA
A_LI --> C_LI
A_IMG --> C_IMG
A_MA --> C_MA
A_MO --> C_MO
A_AD --> C_AD
A_SY --> C_SY

' the import process loads only the import module
IMPORT_APP --> C_IM : loads

' core modules call each other's exported services
C_AD --> C_MO
C_AD --> C_MA
C_AD --> C_CA
C_AD --> C_ID
C_MO --> C_LI
C_MO --> C_PR
C_MO --> C_CA
C_MO --> C_ID
C_MA --> C_CA
C_MA --> C_PR
C_LI --> C_CA
C_LI --> C_PR
C_PR --> C_ID
C_PR --> C_IMG
C_LI --> C_IMG
C_ID --> C_NO
C_IM --> C_JO

' keep infra under core
C_NO -[hidden]-> I_MSG

' infra implements the ports of core
CORE <|.. I_PRISMA
C_ID <|.. I_AUTH
C_NO <|.. I_MSG
C_IMG <|.. I_IMG
C_JO <|.. I_JOBS
C_IM <|.. I_PROV
C_IM <|.. I_GEO
C_IM <|.. I_STUBS

legend right
  Solid arrow: calls (constructor injection)
  Dashed arrow: implements
  ESLint rejects any other import across these boxes
  Classes and methods: code-structure-api, -core-users, -core-events,
  -core-operations, -infra and -import
endlegend

@enduml
