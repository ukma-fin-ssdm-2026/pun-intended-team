@startuml code-structure
/'
  AI Usage Note
  Drafted with Claude from the code in src/.
'/
title Nearby — Code Structure (src/): selected modules, not all of them

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
hide circle

package "api (HTTP)" as API {
  class AuthGuard
  class EventsController
  class CategoriesController
  class AdminCategoriesController
  class ListingsController
}

package "core (business logic)" as CORE {
  package identity {
    class AuthService {
      +authenticate(accessToken)
    }
    class SessionsService {
      +isActive(sessionId, accountId)
    }
    abstract class AccessTokens {
      +verify(token)
    }
    abstract class SessionsRepository {
      +create(session)
      +findById(id)
      +rotate(id, currentHash, next)
      +revoke(id, revokedAt)
      +revokeAll(accountId, revokedAt, exceptId)
    }
  }

  package listings {
    class ListingsService {
      +list(page)
      +getById(id)
      +create(accountId, input)
      +remove(accountId, id)
    }
    abstract class ListingsRepository {
      +findActive(fromDate, page)
      +findActiveById(id)
      +findByIds(ids)
      +create(listing)
      +markRemoved(id)
    }
  }

  package catalog {
    class EventsService {
      +list(query, page)
      +find(id)
      +getById(id)
      +create(accountId, input)
      +update(accountId, id, changes)
      +cancel(accountId, id)
    }
    class CategoriesService {
      +findActive(id)
      +findAll()
      +listActive()
      +getById(id)
      +create(input)
      +update(id, changes)
      +delete(id)
    }
    abstract class EventsRepository {
      +findById(id)
      +findPublished(filter, page)
      +countPublishedEndingAfter(instant)
      +create(event)
      +update(id, changes)
    }
    abstract class CategoriesRepository {
      +findById(id)
      +findAll()
      +create(category)
      +update(id, changes)
      +delete(id)
    }
    abstract class VenuesRepository {
      +findById(id)
    }
    abstract class OrganizationsRepository {
      +findByAccountId(accountId)
    }
  }

  package profiles {
    class ProfilesService {
      +getSummaries(accountIds)
    }
    abstract class ProfilesRepository {
      +findSummaries(accountIds)
    }
  }
}

package "infra (bound in InfraModule)" as INFRA {
  package "prisma" {
    class PrismaSessionsRepository
    class PrismaCategoriesRepository
    class PrismaProfilesRepository
    class PrismaListingsRepository
    class PrismaEventsRepository
    class PrismaVenuesRepository
    class PrismaOrganizationsRepository
  }
}

package "import (bound in ImportInfraModule, process src/import/)" as IMPORT {
  package "core/import" {
    class EventImportService {
      +run()
      +importFrom(provider)
    }
    abstract class EventProvider {
      +fetch()
      +normalize(raw)
    }
    abstract class Geocoder {
      +locate(venue)
    }
    abstract class ImportedEventsRepository {
      +findCategories()
      +failUnfinishedRuns(provider)
      +startRun(provider)
      +finishRun(runId, status, details)
      +lastCompleteRun(provider)
      +saveSkipped(runId, raw, reason)
      +findVenues()
      +updateVenueLocation(id, location)
      +createVenue(venue)
      +findEvent(provider, externalId)
      +createEvent(event)
      +updateEvent(id, fields)
      +cancelUnseen(provider, seenExternalIds, range)
    }
  }
  package "infra" as IMPORT_INFRA {
    class ArtWizardEventProvider
    class KarabasEventProvider
    class NominatimGeocoder
    class PrismaImportedEventsRepository
  }
}

' api calls core services
AuthGuard --> AuthService
EventsController --> EventsService
CategoriesController --> CategoriesService
AdminCategoriesController --> CategoriesService
ListingsController --> ListingsService

' other modules call the same exported services
ListingsService --> EventsService
ListingsService --> CategoriesService
ListingsService --> ProfilesService

' services reach storage through repositories
AuthService --> AccessTokens
AuthService --> SessionsService
SessionsService --> SessionsRepository
ListingsService --> ListingsRepository
EventsService --> CategoriesService
EventsService --> EventsRepository
EventsService --> VenuesRepository
EventsService --> OrganizationsRepository
CategoriesService --> CategoriesRepository
ProfilesService --> ProfilesRepository

' infra implements core repositories
SessionsRepository <|.. PrismaSessionsRepository
ListingsRepository <|.. PrismaListingsRepository
EventsRepository <|.. PrismaEventsRepository
CategoriesRepository <|.. PrismaCategoriesRepository
VenuesRepository <|.. PrismaVenuesRepository
OrganizationsRepository <|.. PrismaOrganizationsRepository
ProfilesRepository <|.. PrismaProfilesRepository

' the import runs as its own process, with its own infra bindings
EventImportService --> EventProvider
EventImportService --> Geocoder
EventImportService --> ImportedEventsRepository
EventProvider <|.. ArtWizardEventProvider
EventProvider <|.. KarabasEventProvider
Geocoder <|.. NominatimGeocoder
ImportedEventsRepository <|.. PrismaImportedEventsRepository

legend right
  Solid arrow: calls (constructor injection)
  Dashed arrow: implements
  ESLint rejects any other import across these boxes
endlegend

@enduml
