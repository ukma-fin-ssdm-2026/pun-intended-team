@startuml code-structure-core-events
/'
  AI Usage Note
  Drafted with Claude from the code in src/.
'/
title Nearby — Code Structure (src/core/), events: catalog, listings, matching

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
hide circle
skinparam class {
  BackgroundColor<<other diagram>> #F4F4F4
  BorderColor<<other diagram>> #A0A0A0
  FontColor<<other diagram>> #707070
}

package "core (business logic)" as CORE {
  package catalog {
    class EventsService {
      +stats()
      +list(query, page)
      +find(id)
      +getById(id)
      +create(accountId, input)
      +update(accountId, id, input)
      +cancel(accountId, id)
    }
    class EventSessionsService {
      +open(eventId, days, tx)
      +getByIds(ids, tx)
      +reconcile(eventId, tx, now)
    }
    class CategoriesService {
      +findActive(id)
      +findAll()
      +listActive()
      +getById(id)
      +create(input)
      +update(id, changes)
      +delete(id)
    }
    class OrganizationsService {
      +getOwn(accountId)
      +request(accountId, request)
      +find(accountId)
      +listRequests(page)
      +decide(accountId, decision, adminId)
    }
    class ImportFreshnessService {
      +lastUpdatedAt()
    }
    abstract class EventsRepository {
      +findById(id, tx)
      +findPublished(filter, page)
      +countPublishedEndingAfter(instant)
      +create(event)
      +update(id, changes, tx)
    }
    abstract class EventSessionsRepository {
      +findOrCreateMany(eventId, starts, tx)
      +findByIds(ids, tx)
      +findByEvent(eventId, tx)
      +setStatus(ids, status, tx)
    }
    abstract class CategoriesRepository {
      +findById(id)
      +findAll()
      +create(category)
      +update(id, changes)
      +delete(id)
    }
    abstract class VenuesRepository {
      +findById(id)
    }
    abstract class OrganizationsRepository {
      +findByAccountId(accountId)
      +create(accountId, request)
      +resubmit(accountId, request)
      +findPage(page)
      +decide(accountId, decision, adminId, at)
    }
    abstract class ImportRunsRepository {
      +freshness()
    }
  }
  package listings {
    class ListingsService {
      +list(page)
      +getById(id)
      +create(accountId, input)
      +remove(accountId, id)
      +findByIds(ids)
      +removeReported(id)
    }
    abstract class ListingsRepository {
      +findActiveById(id)
      +findByIds(ids)
      +findActive(fromDate, page)
      +create(listing)
      +markRemoved(id)
    }
  }
  package matching {
    class ApplicationsService {
      +apply(userId, input)
      +listMine(userId)
      +getOwn(userId, id)
      +withdraw(userId, id)
    }
    class MatchingService {
      +stats()
      +scheduleRounds(sessions, tx)
      +matchOnApply(application)
      +withdraw(application, from)
      +runRound(sessionId)
    }
    class MatchesService {
      +listMine(userId)
      +getOwn(userId, id)
      +accept(userId, id)
      +decline(userId, id)
      +getContacts(userId, id)
    }
    class EventChangesService {
      +handle(payload, now)
    }
    abstract class ApplicationsRepository {
      +create(application, tx)
      +findPool(sessionIds, tx)
      +findById(id)
      +findByUserAndEvent(userId, eventId)
      +findByUserWithStatus(userId, statuses)
      +withdraw(id, from, tx)
      +findBySessions(sessionIds, statuses, tx)
      +cancel(ids, from, tx)
      +removeDays(ids, sessionIds, tx)
      +moveDay(fromSessionId, toSessionId, tx)
    }
    abstract class MatchesRepository {
      +count()
      +lockEvent(eventId, tx)
      +findExcludedPairs(eventId, tx)
      +propose(match, tx)
      +findById(id, tx)
      +findByUser(userId, statuses)
      +findByApplication(applicationId, statuses, tx)
      +setStatus(id, from, to, tx)
      +decline(match, userId, tx)
      +cancelForWithdrawal(match, applicationId, tx)
      +cancelPending(applicationIds, reason, tx)
      +cancelAndReturnBoth(match, reason, tx)
    }
  }
}

' other modules' classes, shown with their methods on their own diagram
