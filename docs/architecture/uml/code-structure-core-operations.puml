@startuml code-structure-core-operations
/'
  AI Usage Note
  Drafted with Claude from the code in src/.
'/
title Nearby — Code Structure (src/core/), operations: admin, system, notifications, images, jobs, common

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
hide circle
skinparam class {
  BackgroundColor<<other diagram>> #F4F4F4
  BorderColor<<other diagram>> #A0A0A0
  FontColor<<other diagram>> #707070
}

package "core (business logic)" as CORE {
  package admin {
    class StatsService {
      +get()
    }
    class BackupsService {
      +status(now)
      +history(now)
    }
    abstract class BackupRunsRepository {
      +recent(limit)
      +lastSucceededAt()
    }
  }
  package system {
    class HealthService {
      +check()
    }
    abstract class DatabaseProbe {
      +ping()
    }
  }
  package notifications {
    class NotificationsService {
      +sendCode(phone, code)
      +notify(accountId, type, payload, dedupeKey, tx)
      +listMine(accountId, page)
      +markRead(accountId, id)
      +registerDevice(accountId, sessionId, device)
      +removeDevice(sessionId, tx)
      +removeDevices(accountId, exceptSessionId, tx)
      +deliver(notificationId)
    }
    abstract class MessagingProvider {
      +sendCode(phone, code)
    }
    abstract class NotificationsRepository {
      +create(notification, tx)
      +findById(id, tx)
      +findByAccount(accountId, page, tx)
      +markRead(accountId, id, tx)
      +updatePushStatus(id, from, to, tx)
    }
    abstract class DeviceTokensRepository {
      +register(device, tx)
      +findByAccount(accountId, tx)
      +deleteBySession(sessionId, tx)
      +deleteByAccount(accountId, exceptSessionId, tx)
      +deleteByPushTokens(pushTokens, tx)
    }
    abstract class PushProvider {
      +send(messages)
    }
  }
  package images {
    class ImagesService {
      +prepare(kind, upload)
      +save(ownerId, prepared, tx)
      +getRefs(ids)
      +getFile(id)
      +remove(ids, tx)
    }
    abstract class ImagesRepository {
      +create(image, tx)
      +findRefs(ids)
      +findFile(id)
      +delete(ids, tx)
    }
    abstract class ImageProcessor {
      +measure(content)
      +encode(content, options)
    }
  }
  package jobs {
    abstract class JobQueue {
      +enqueue(name, payload, options, tx)
      +register(name, handler, options)
      +schedule(name, cron, payload, key)
    }
  }
  package common {
    abstract class TransactionRunner {
      +run(work)
    }
    class DomainError
  }
}

' other modules' classes, shown with their methods on their own diagram
class AccountsService <<other diagram>>
class EventsService <<other diagram>>
class MatchingService <<other diagram>>
class ModerationService <<other diagram>>
class AuthService <<other diagram>>
class SessionsService <<other diagram>>
class ProfilesService <<other diagram>>
class ListingsService <<other diagram>>

' services call services and reach storage and adapters through abstract classes
AuthService --> NotificationsService
SessionsService --> NotificationsService
StatsService --> AccountsService
StatsService --> EventsService
StatsService --> MatchingService
StatsService --> ModerationService
StatsService --> BackupsService
BackupsService --> BackupRunsRepository
HealthService --> DatabaseProbe
NotificationsService --> MessagingProvider
NotificationsService --> NotificationsRepository
NotificationsService --> DeviceTokensRepository
NotificationsService --> PushProvider
NotificationsService --> JobQueue
ProfilesService --> ImagesService
ListingsService --> ImagesService
ImagesService --> ImagesRepository
ImagesService --> ImageProcessor

legend right
  Solid arrow: calls (constructor injection)
  Dashed arrow: implements
  ESLint rejects any other import across these boxes
  Abstract classes (italic) are implemented in infra: see code-structure-infra
  Grey boxes: classes of other modules, shown with their methods on their own diagram
endlegend

@enduml
