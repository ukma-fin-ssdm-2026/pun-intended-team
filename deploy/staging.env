NODE_ENV=production
SWAGGER_UI=false
CORS_ORIGINS=${CORS_ORIGINS:-}
AUTH_RATE_LIMIT_PER_MINUTE=20

CODE_HMAC_KEY_FILE=keys/code-hmac.key
JWT_KEYS_FILE=keys/jwt-keys.json
CONTACT_HMAC_KEY_FILE=keys/contact-hmac.key
DATA_ENCRYPTION_KEY_FILE=keys/data-encryption.key

MESSAGING_PROVIDER=disabled
TELEGRAM_GATEWAY_TOKEN=${TELEGRAM_GATEWAY_TOKEN:-}
TURBOSMS_TOKEN=${TURBOSMS_TOKEN:-}
TURBOSMS_SENDER=${TURBOSMS_SENDER:-}

GOOGLE_CLIENT_IDS=${GOOGLE_CLIENT_IDS}

POSTGRES_USER=nearby
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=nearby
DATABASE_URL=postgresql://nearby:${POSTGRES_PASSWORD}@db:5432/nearby?schema=public
MAIN_DATABASE_URL=postgresql://nearby_main:${NEARBY_MAIN_PASSWORD}@db:5432/nearby?schema=public
IMPORT_DATABASE_URL=postgresql://nearby_import:${NEARBY_IMPORT_PASSWORD}@db:5432/nearby?schema=public

API_DOMAIN=api.nearbystaging.app
BACKUP_DIR=/var/backups/nearby
