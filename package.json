{
  "name": "nearby-api",
  "version": "0.1.0",
  "private": true,
  "description": "Nearby REST API (Code-First: the OpenAPI spec is generated from zod schemas)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "docs:generate": "tsx src/scripts/generate-spec.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "express": "^5.2.1",
    "js-yaml": "^4.3.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0"
  }
}
