{
  "name": "nearby-api",
  "version": "0.1.0",
  "private": true,
  "description": "Nearby REST API (Code-First: the OpenAPI spec is generated from zod schemas)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "keys:generate": "node src/scripts/generate-keys.ts",
    "docs:generate": "nest build && node dist/scripts/generate-spec.js",
    "mcp:generate": "npm ci --prefix tools/mcp-generator && tools/mcp-generator/node_modules/.bin/openapi-mcp-generator --input docs/api/openapi-generated.yaml --output src/mcp --server-name nearby-api-mcp --force && npm install --prefix src/mcp --save-dev --save-exact shx@0.3.4",
    "mcp:build": "npm ci --prefix src/mcp && npm run build --prefix src/mcp",
    "test:e2e": "nest build && node --test \"test/e2e/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "js-yaml": "^4.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1"
  }
}
