{
  "name": "nearby-api",
  "version": "0.1.0",
  "private": true,
  "description": "Nearby REST API (Code-First: the OpenAPI spec is generated from zod schemas)",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "docs:generate": "nest build && node dist/scripts/generate-spec.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "js-yaml": "^4.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "typescript": "~6.0"
  }
}
