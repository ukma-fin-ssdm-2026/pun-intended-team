# EXPO_PUBLIC_* values are inlined into the client bundle, so never put real secrets here.
# Without EXPO_PUBLIC_API_URL the client uses http://<host that served the app>:4100.
# EXPO_PUBLIC_API_URL=http://localhost:4100

# Google sign-in: the OAuth client id of a Google "Web application" client with
# http://localhost:8081 as an authorised JavaScript origin. The web build shows its button; on iOS and Android the ID
# tokens are issued to it. The API's GOOGLE_CLIENT_IDS must include it.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Google sign-in in the iOS build: the OAuth client id of a Google "iOS" client with the bundle ID
# ua.nearby.app. The API's GOOGLE_CLIENT_IDS must include it. Rebuild the app after changing it.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def.apps.googleusercontent.com
