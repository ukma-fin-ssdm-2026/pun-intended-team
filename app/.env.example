# EXPO_PUBLIC_* values are inlined into the client bundle, so never put real secrets here.
# Without EXPO_PUBLIC_API_URL the client uses http://<host that served the app>:4100.
# EXPO_PUBLIC_API_URL=http://localhost:4100

# Shows "Sign in with Google" in the web build: the OAuth client id of a Google "Web application" client with
# http://localhost:8081 as an authorised JavaScript origin. The API's GOOGLE_CLIENT_IDS must include it.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
