# How it was verified: built the image and opened the pages, a refreshed event page and the hidden routes through it.
# Reviewed by: Viktoriia Baran

FROM node:26-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
# EXPO_PUBLIC_* values are inlined into the bundle at build time.
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_GOOGLE_CLIENT_ID
RUN test -n "$EXPO_PUBLIC_API_URL" && test -n "$EXPO_PUBLIC_GOOGLE_CLIENT_ID" && \
  npx expo export -p web && rm -rf dist/dev

FROM caddy:2
LABEL org.opencontainers.image.source=https://github.com/ukma-fin-ssdm-2026/pun-intended-team
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD ["wget", "-q", "--spider", "http://localhost/"]
