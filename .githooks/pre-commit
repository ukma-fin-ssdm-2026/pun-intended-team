#     git config core.hooksPath .githooks

if ! command -v pre-commit >/dev/null 2>&1; then
	echo "pre-commit is not installed. Install it once with:" >&2
	echo >&2
	echo "    pipx install pre-commit" >&2
	echo >&2
	echo "See the README, section 'Commit hooks'." >&2
	exit 1
fi

exec pre-commit run
